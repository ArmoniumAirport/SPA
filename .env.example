# ================================================================
# Variables de entorno del bot de Armonium
# ----------------------------------------------------------------
# ESTE archivo es solo un EJEMPLO (sin secretos). Se puede subir a GitHub.
# Los valores reales se cargan en Netlify (Site settings > Environment variables),
# NUNCA en el codigo ni en GitHub.
# ================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar. Recomendado para arrancar (barato y rapido): gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (Meta Cloud API) ---
# Token de acceso de tu app de Meta (temporal de 24h para pruebas, o permanente)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# ID del numero de telefono (lo da Meta en la seccion de WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Version de la Graph API (opcional)
GRAPH_VERSION=v21.0

# --- Verificacion del webhook ---
# Una palabra secreta que vos inventas. Tiene que ser IGUAL en Meta y aca.
VERIFY_TOKEN=armonium_verify_2026
